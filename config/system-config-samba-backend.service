[Unit]
Description=system-config-samba privileged D-Bus backend
Documentation=https://example.invalid/system-config-samba
After=dbus.service

[Service]
# D-Bus activation: dbus asks systemd to start this unit when something calls
# org.fedoraproject.Config.Samba on the system bus; systemd waits for the bus name to be
# acquired (Type=dbus) before letting the method call through.
Type=dbus
BusName=org.fedoraproject.Config.Samba
# @python@ and @libexecdir@ are substituted by the installer (see README).
ExecStart=@python@ @libexecdir@/system-config-samba-backend
User=root
Restart=on-failure
RestartSec=2

# Lockdown where compatible with writing /etc/samba and driving systemctl.
NoNewPrivileges=false
ProtectHome=true
