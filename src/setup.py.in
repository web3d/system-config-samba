#!/usr/bin/python

from distutils.core import setup

setup (
        name = "scsamba",
        version = "@VERSION@",
        packages = ["scsamba", "scsamba.core"]
        )

setup (
        name = "scsamba.dbus",
        version = "@VERSION@",
        packages = ["scsamba.dbus", "scsamba.dbus.service", "scsamba.dbus.proxy"]
        )
