#: src/shareWindow.py:209
msgid ""
"You must specify a directory to share.  \n"
"\n"
"Click \"OK\" to continue."
msgstr ""
"Du må spesifisere en katalog som skal deles ut.\n"
"\n"
"Klikk «OK» for å fortsette."

#: src/shareWindow.py:223
#, python-format
msgid ""
"The directory \"%s\" does not exist.  Please specify an existing "
"directory. \n"
"\n"
"Click \"OK\" to continue."
msgstr ""
"Katalogen «%s» eksisterer ikke. Vennligst oppgi en eksisterende katalog.\n"
"\n"
"Klikk «OK» for å fortsette."

#: src/shareWindow.py:242
msgid ""
"Please set a share name.\n"
"\n"
"Click \"OK\" to continue."
msgstr ""
"Du må sett et navn på delt ressurs.\n"
