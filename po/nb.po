msgstr "Navnet «%s» er reservert."

#: src/shareWindow.py:248
msgid ""
"\n"
"Please use a different share name.\n"
"\n"
"Click \"Suggest Share Name\" or \"OK\" to continue."
msgstr ""
"\n"
"Vennligst bruk et annet navn på den delte ressursen.\n"
"\n"
"Klikk «Foreslå navn på delt ressurs» eller «OK» for å fortsette."

